# Copy to .env and adjust. All vars are prefixed with APP_.
APP_ENVIRONMENT=dev
APP_DEBUG=true

APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5544/realestate
APP_DB_ECHO=false

# Embeddings: local (default, sentence-transformers, 384 dims) | openai | fake
APP_EMBEDDING_PROVIDER=local
# APP_OPENAI_API_KEY=      # required only for APP_EMBEDDING_PROVIDER=openai

# Filled in later phases:
# APP_AWS_REGION=us-east-1
